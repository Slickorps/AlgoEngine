# AlgoEngine environment configuration
# Copy this file to .env and fill in your values. Never commit .env.

# ── Logging ─────────────────────────────────────────────────────────
ALGO_LOG_LEVEL=INFO
ALGO_LOG_FILE=logs/algo.log
ALGO_DB_PATH=data/algo.db

# ── Data providers ──────────────────────────────────────────────────
YAHOO_ENABLED=true
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_ENABLED=false

# ── Brokers ─────────────────────────────────────────────────────────
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ENVIRONMENT=demo

# ── Database ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algoengine
DB_USER=algo
DB_PASSWORD=

# ── Redis ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Trading ─────────────────────────────────────────────────────────
DEFAULT_BROKER=paper
PAPER_TRADING=true
DEFAULT_CURRENCY=USD
